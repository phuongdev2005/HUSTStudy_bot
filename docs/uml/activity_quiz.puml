@startuml activity_quiz
title Activity Diagram — Ôn tập từ vựng (/quiz)

skinparam ActivityBackgroundColor LightCyan
skinparam ActivityBorderColor DarkBlue
skinparam ActivityArrowColor DarkBlue
skinparam swimlane {
    BorderColor DarkGray
}

|Người dùng|
start
:Gõ /quiz;

|Python Bot|
:Gọi Java API\nGET /vocabulary/words?dueOnly=true;

|Java API + MySQL|
:SELECT * FROM words\nWHERE user_id=? AND next_review_at <= NOW()\nORDER BY level ASC;
:Trả danh sách từ cần ôn;

|Python Bot|
if (Có từ cần ôn?) then (Có)
    :Shuffle danh sách từ;
    :Khởi tạo quiz session\n(active_sessions[user_id]);

    repeat
        :Lấy từ tiếp theo;
        :Gửi câu hỏi:\n"<từ>" nghĩa là gì?;

        |Người dùng|
        :Nhập đáp án;

        |Python Bot|
        :check_answer(telegram_id, đáp án);

        if (Đáp án đúng?) then (Đúng)
            :correct += 1;
            :Gửi: Chính xác!;
        else (Sai)
            :wrong += 1;
            :Gửi: Sai! Đáp án đúng: <nghĩa>;
        endif

    repeat while (Còn từ tiếp theo?) is (Có)
    -> Hết;

    :Tính kết quả (score_percent);
    :Lưu QuizResult vào DB;
    :Cập nhật level & next_review_at\ncho từng từ;
    :Gửi kết quả tổng kết:\n 8/10 đúng — 80%;

else (Không)
    :Gửi thông báo:\n Không có từ nào cần ôn hôm nay!;
endif

|Người dùng|
:Nhận kết quả;

stop
@enduml
