@startuml sequence_addexpense
title Sequence Diagram — Ghi chi tiêu (/addexpense)

skinparam SequenceArrowThickness 2
skinparam ParticipantBackgroundColor WhiteSmoke
skinparam ParticipantBorderColor DarkOrange

actor       "Người dùng"    as User
participant "Telegram API"  as TG
participant "Python Bot"    as Bot
participant "Java API\n(:8081)" as API
database    "MySQL"         as DB

User -> TG  : /addexpense 35000 cơm trưa
TG   -> Bot : Update { message: "/addexpense 35000 cơm trưa" }
Bot  -> Bot : Parse: amount=35000, note="cơm trưa"

Bot  -> TG  : sendMessage(keyboard chọn danh mục)
TG   -> User : [Ăn uống] [Di chuyển] [Học phí] [Giải trí]
User -> TG  : Chọn "Ăn uống"
TG   -> Bot : CallbackQuery { data: "cat_food" }

Bot  -> API : POST /expense/transactions\n{ telegramId, type:EXPENSE, amount:35000,\n  categoryId:1, note:"cơm trưa" }

API  -> DB  : INSERT INTO transactions\n(user_id, category_id, type, amount, note, transacted_at)
DB  --> API : transaction_id = 42

API  -> DB  : SELECT SUM(amount) FROM transactions\nWHERE user_id=? AND category_id=1\nAND MONTH(transacted_at)=MONTH(NOW())
DB  --> API : total_month = 850000

API  -> DB  : SELECT limit_amount FROM budgets\nWHERE user_id=? AND category_id=1\nAND month=6 AND year=2025
DB  --> API : limit_amount = 1000000

API  -> API : percentage = 850000/1000000 = 85%
API --> Bot : 201 { transactionId:42,\n  totalMonth:850000, budgetPercent:85 }

alt budgetPercent >= 80
    Bot -> TG  : sendMessage(\n"✅ Đã ghi: -35,000đ | Ăn uống | cơm trưa\n⚠️ Đã dùng 85% ngân sách Ăn uống!")
else budgetPercent < 80
    Bot -> TG  : sendMessage(\n"✅ Đã ghi: -35,000đ | Ăn uống | cơm trưa")
end

TG   -> User : Hiển thị xác nhận

@enduml
