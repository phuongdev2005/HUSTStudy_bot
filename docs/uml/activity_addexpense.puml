@startuml activity_addexpense
title Activity Diagram — Ghi chi tiêu (/addexpense)

skinparam ActivityBackgroundColor LightYellow
skinparam ActivityBorderColor DarkOrange
skinparam ActivityArrowColor DarkOrange
skinparam swimlane {
    BorderColor DarkGray
    TitleFontSize 13
}

|Người dùng|
start
:Gõ /addexpense 35000 cơm trưa;

|Python Bot|
:Nhận lệnh từ Telegram;
:Parse tham số (số tiền, ghi chú);

if (Parse được số tiền?) then (Có)
    :Gửi keyboard chọn danh mục\n(Ăn uống / Di chuyển / Học phí / ...);

    |Người dùng|
    :Chọn danh mục;

    |Python Bot|
    :Nhận callback danh mục;
    :Gọi Java API\nPOST /expense/transactions;

    |Java API + MySQL|
    :INSERT INTO transactions\n(user_id, category_id, type, amount, note);
    :Tính tổng chi theo danh mục\ntrong tháng hiện tại;
    :Kiểm tra ngân sách (budgets);
    :Trả TransactionResponse;

    |Python Bot|
    if (Đã dùng >= 80% ngân sách?) then (Có)
        :Gửi xác nhận + cảnh báo:\n Đã ghi -35,000đ | Ăn uống\n Đã dùng 85% ngân sách!;
    else (Không)
        :Gửi xác nhận:\n Đã ghi: -35,000đ | Ăn uống | cơm trưa;
    endif

else (Không)
    :Gửi hướng dẫn:\n Sai format!\nDùng: /addexpense <số_tiền> <ghi_chú>;
endif

|Người dùng|
:Nhận phản hồi từ bot;

stop
@enduml
