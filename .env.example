# ============================================================
#  HUSTStudy Bot – Environment Template
#  Sao chép file này thành .env rồi điền giá trị thực.
#  File này ĐƯỢC commit lên git (không chứa secret thật).
# ============================================================

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=huststudy_bot
DB_USER=studybot
DB_PASSWORD=your_db_password_here

# MySQL root (chỉ dùng cho Docker)
DB_ROOT_PASSWORD=your_root_password_here

# Backend API
SERVER_PORT=8081

# Google Sheets (điền sau khi tạo Service Account)
GOOGLE_CREDENTIALS_PATH=classpath:google-credentials.json
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# Telegram Bot (lấy từ @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_BOT_USERNAME=your_bot_username_here
